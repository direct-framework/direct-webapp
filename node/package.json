{
    "name": "direct-webapp",
    "description": "DIRECT WebApp",
    "version": "0.1.0",
    "homepage": "https://github.com/direct-framework/direct-webapp",
    "license": "MIT",
    "main": "index.html",
    "engines": {
        "node": ">=26.12.1",
        "npm": ">=11.2.0"
    },
    "scripts": {
        "build": "npm-run-all --silent -p styles:expanded styles:minified scripts:expanded scripts:minified vendor --silent",
        "styles:expanded": "node build/styles.js expanded",
        "styles:minified": "node build/styles.js minified",
        "scripts:expanded": "node build/scripts.js expanded",
        "scripts:minified": "node build/scripts.js minified",
        "vendor": "node build/vendor.js",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest",
        "test-ui": "vitest --ui",
        "test-ci": "vitest --run",
        "lint": "eslint build src stories --ext .js",
        "lint:fix": "eslint build src stories --ext .js --fix"
    },
    "devDependencies": {
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-virtual": "^3.0.2",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/html": "^10.6.5",
        "@storybook/html-vite": "^10.6.5",
        "autoprefixer": "^10.4.16",
        "browser-sync": "^3.0.4",
        "cssnano": "^6.0.1",
        "eslint": "^8.53.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "eslint-plugin-storybook": "^10.6.5",
        "fs-extra": "^11.1.1",
        "jsdom": "^30.1.3",
        "npm-run-all": "^4.1.5",
        "npmlog": "^7.0.1",
        "postcss": "^8.4.31",
        "prettier": "^3.0.3",
        "rollup": "^4.4.0",
        "sass": "^1.69.5",
        "storybook": "^10.6.5",
        "stylelint": "^15.11.0",
        "stylelint-config-twbs-bootstrap": "^11.0.1",
        "svgo": "^3.0.3",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "aos": "^2.3.4",
        "bootstrap": "^5.3.2",
        "d3": "^7.9.0",
        "imagesloaded": "^5.0.0",
        "simplebar": "^6.2.5",
        "smooth-scroll": "^16.1.3"
    }
}
